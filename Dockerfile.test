# Dockerfile for testing the refactored architecture
# This builds on the original image and adds the refactored code
# docker build -f .\Dockerfile.test -t sqlbot-refactor:test .

# Arguments
ARG ORIGINAL_IMAGE=dataease/sqlbot:v1.5.0

FROM ${ORIGINAL_IMAGE} AS refactor-tester

ENV PYTHONUNBUFFERED=1
ENV SQLBOT_HOME=/opt/sqlbot
ENV PYTHONPATH=${SQLBOT_HOME}/app
ENV PATH="${SQLBOT_HOME}/app/.venv/bin:$PATH"
ENV UI_HOME=${SQLBOT_HOME}/frontend

# Set the new algorithm flag for testing
ENV USE_NEW_ALGORITHM=true

# Copy pre-built frontend dist (built locally with: cd frontend && npm run build)
# COPY frontend/dist/ ${UI_HOME}/dist/

WORKDIR ${SQLBOT_HOME}/app

# Create necessary directories
RUN mkdir -p ${SQLBOT_HOME}/app

# Copy the refactored backend code
# This will override the original backend code with the refactored version
COPY backend/ ${SQLBOT_HOME}/app/

# Copy tests (optional)
COPY backend/tests/ ${SQLBOT_HOME}/app/tests/

# Verify the new modules are in place
RUN python -c "from apps.business_db.service import BusinessDBService; from apps.algorithm.engine import AlgorithmEngine; print('Refactored modules loaded successfully!')"

EXPOSE 3000 8000 8001 5432

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000 || exit 1

# Use the original entrypoint
ENTRYPOINT ["sh", "start.sh"]
