# Dockerfile.test - 基于原版功能正常的 image，构建重构版本测试 image

# ==============================================================================
# 构建命令（在项目根目录执行）:
#   docker build -f Dockerfile.test -t sqlbot:test-refactor .
#
# 运行测试:
#   docker run --rm sqlbot:test-refactor python -m pytest tests/ -v
#
# 或使用 docker-compose:
#   docker-compose -f test_docker_compose.yaml up test
# ==============================================================================

# ------------------------------------------------------------------------------
# 阶段 1: 基于原版功能正常的 image
# ------------------------------------------------------------------------------
FROM dataease/sqlbot:latest AS sqlbot-original

# 设置环境变量
ENV SQLBOT_HOME=/opt/sqlbot
ENV APP_HOME=${SQLBOT_HOME}/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=${SQLBOT_HOME}/app
ENV PATH="${APP_HOME}/.venv/bin:$PATH"

# 创建必要目录
RUN mkdir -p ${APP_HOME}/tests

# ------------------------------------------------------------------------------
# 阶段 2: 复制重构版本的 backend 代码
# ------------------------------------------------------------------------------
# 复制整个 backend 目录（包含重构的 algorithm 层和 business_db 层）
COPY backend/ ${APP_HOME}/

# 确保测试文件存在
COPY tests/ ${APP_HOME}/tests/

# ------------------------------------------------------------------------------
# 阶段 3: 安装测试依赖并运行测试
# ------------------------------------------------------------------------------
WORKDIR ${APP_HOME}

# 安装测试依赖（基于 uv）
RUN uv sync --extra cpu --no-install-project && \
    uv pip install pytest>=7.4.3 pytest-cov>=4.1.0 && \
    uv sync

# 验证重构版本可以正常导入
RUN python -c "
from apps.algorithm.schema import AlgorithmInput
from apps.algorithm.result import AlgorithmResult, AlgorithmLog
from apps.algorithm.service import AlgorithmService
from apps.business_db import BusinessDataLayer
print('✓ All refactored modules imported successfully')
"

# 运行单元测试
# 注意: 部分测试需要完整 Docker 环境（/opt/sqlbot），这些测试会在集成测试中覆盖
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short", "-x"]
